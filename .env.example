APP_NAME="SJ-SIG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Usar la IP LAN actual del servidor (cualquier equipo de la red: http://IP:8086).
# Laravel ajusta URLs al Host de la petición (ForceRequestRootUrl).
APP_URL=http://172.16.16.70:8086
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sj_sig
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sj-sig.test"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@sj-sig.test
ADMIN_NAME="Administración SJ"
ADMIN_PASSWORD=Sig2026!
SEED_PASSWORD=Sig2026!

GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
